# Copy this file to .env and fill in real values.
# NEVER commit .env. On the Pi: chmod 600 .env

# ---------- MQTT broker (Mosquitto) ----------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=livinglab
MQTT_PASSWORD=change_me
MQTT_CLIENT_ID_PREFIX=livinglab
MQTT_TLS=false

# Topic prefix used by all firmware + services. Must match docs/mqtt-topics.md
MQTT_TOPIC_PREFIX=livinglab

# ---------- MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livinglab
DB_USER=livinglab
DB_PASSWORD=change_me

# ---------- Telegram bot ----------
# Get the token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here
# Comma-separated numeric chat ids allowed to send commands
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# ---------- Services ----------
# Seconds between health checks / alerts
ALERT_COOLDOWN_SECONDS=300
LOG_LEVEL=INFO