# Copy this file to .env and fill in real values.
# NEVER commit .env. On the Pi: chmod 600 .env

# ---------- MQTT broker (Mosquitto) ----------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=livinglab
MQTT_PASSWORD=change_me
MQTT_CLIENT_ID_PREFIX=livinglab
MQTT_TLS=false

# Topic prefix used by all firmware + services. Must match docs/mqtt-topics.md
# Note: this project publishes under "smartgreengarden"
MQTT_TOPIC_PREFIX=smartgreengarden

# ---------- MariaDB ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livinglab
DB_USER=livinglab
DB_PASSWORD=change_me

# Telegram bot tables
DB_TABLE=hydroponic_water_data_romy
DB_TIME_COLUMN=datetime
DB_TIME_IS_STRING=false
DB_TIME_STRING_FORMAT=%Y-%m-%d %H:%i:%s

# ---------- Telegram bot ----------
# Get the token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here
# Chat that receives scheduled updates and alerts
TELEGRAM_CHAT_ID=123456789
# Comma-separated numeric chat ids allowed to send commands
TELEGRAM_ALLOWED_CHAT_IDS=123456789
# Password for /login (change it!)
ACCESS_PASSWORD=change_me
SESSION_TIMEOUT_SECONDS=3600

# ---------- Bot runtime ----------
# Where CSV exports and logs are written
EXPORT_DIR=./exports
LOG_DIR=./logs
# Fall back to simulated sensor data when MQTT is unreachable (dev only)
ALLOW_DEV_MODE=false

# ---------- Data logger ----------
# Only one row is written per N seconds, regardless of publish rate
SAVE_THROTTLE_SECONDS=60
# Warn in the log when no message arrives for this long
EXPECTED_INTERVAL_SECONDS=300
# Rotated log files to keep (daily, gzipped)
LOG_BACKUP_COUNT=30

# ---------- Firebase Realtime Database (optional) ----------
# Leave FIREBASE_CRED_PATH empty to run with local MySQL only.
FIREBASE_CRED_PATH=
FIREBASE_DATABASE_URL=
FIREBASE_RTDB_ROOT=Hydroponic_Data

# ---------- Services ----------
# Seconds between health checks / alerts
ALERT_COOLDOWN_SECONDS=300
LOG_LEVEL=INFO