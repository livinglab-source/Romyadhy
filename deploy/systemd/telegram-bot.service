[Unit]
Description=Living Lab Telegram bot
After=network-online.target mariadb.service mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=livinglab
WorkingDirectory=/opt/livinglab/Romyadhy/services/telegram-bot
EnvironmentFile=/opt/livinglab/Romyadhy/.env
ExecStart=/opt/livinglab/Romyadhy/.venv/bin/python telegrambot.py
# Local state (CSV exports + logs) lives next to the service.
StateDirectory=livinglab-telegram-bot
StateDirectoryMode=0750
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target