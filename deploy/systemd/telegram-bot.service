[Unit]
Description=Living Lab Telegram bot
After=network-online.target mariadb.service mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=livinglab
WorkingDirectory=/home/livinglab/workspace/romy/services/telegram-bot
EnvironmentFile=/home/livinglab/workspace/romy/.env
ExecStart=/home/livinglab/workspace/romy/.venv/bin/python telegrambot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target